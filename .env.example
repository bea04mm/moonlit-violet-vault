# Moonlit Violet Vault — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ============================================================
# Supabase (required for both frontend and pipeline)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Pipeline only — service role key (NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================================
# Auth — Single-user access lock
# ============================================================
# The Google account email that is allowed to access the vault.
# Any other Google account will be rejected at sign-in.
ALLOWED_EMAIL=your.email@gmail.com

# ============================================================
# Data Enrichment APIs (pipeline only)
# ============================================================
TMDB_API_KEY=your-tmdb-api-key-here
GOOGLE_BOOKS_API_KEY=your-google-books-api-key-here

# ============================================================
# VLM for OCR (pipeline only)
# Choose your provider: gemini (default) | openai
# ============================================================
VLM_PROVIDER=gemini
GOOGLE_API_KEY=your-google-ai-studio-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
